# Copy to .env and fill in. Do NOT commit the real .env.
#
# Cloudflare API token used by Caddy for ACME DNS-01 on the sing.sh zone.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token.
# Permissions (scoped to the sing.sh zone, not account-wide):
#   Zone : DNS  : Edit
#   Zone : Zone : Read
# Zone Resources: Include → Specific zone → sing.sh
CF_API_TOKEN=
